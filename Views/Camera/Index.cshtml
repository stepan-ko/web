@{
    ViewData["Title"] = "Camera Page";
}

@model List<Camera>

<h2>Камеры</h2>

<p>
    <a asp-action="Create">Добавить камеру</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Название</th>
            <th>Адрес URL</th>
            <th>Симуляция</th>
            <th>Использовать</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var camera in Model)
    {
        <tr>
            <td>@camera.Id</td>
            <td>@camera.Name</td>
            <td>@camera.StreamUrl</td>
            <td>@camera.Simulate</td>
            <td>@camera.Enable</td>
            <td>
                <a asp-action="Edit"
                   asp-route-id="@camera.Id">
                    Изменить
                </a>
                |                
                <form asp-action="Delete"
                asp-route-id="@camera.Id"
                method="post"
                style="display:inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        onclick="return confirm('Удалить камеру?')">
                    Удалить
                </button>
            </form>

            </td>
        </tr>
    }
    </tbody>
</table>