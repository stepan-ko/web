@{
    ViewData["Title"] = "Camera Page";
}

@model List<Camera>

<h2>Камеры</h2>

<p>
    <a asp-action="Create">Добавить камеру</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Название</th>
                <th scope="col">Адрес URL</th>
                <th scope="col">Симуляция</th>
                <th scope="col">Использовать</th>
                <th scope="col" class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var camera in Model)
            {
                <tr>
                    <td>@camera.Id</td>
                    <td>
                        <a asp-controller="Stream" asp-action="Details"
                           asp-route-id="@camera.Id">
                            @camera.Name
                        </a>
                    </td>
                    <td>
                        <span class="text-truncate d-inline-block"
                              style="max-width: 300px; vertical-align: middle;"
                              title="@camera.StreamUrl">
                            @camera.StreamUrl
                        </span>
                    </td>
                    <td>
                        @if (camera.Simulate)
                        {
                            <span class="badge bg-info">Да</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Нет</span>
                        }
                    </td>
                    <td>
                        @if (camera.Enable)
                        {
                            <span class="badge bg-success">Да</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Нет</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <form asp-action="Restart" asp-route-id="@camera.Id"
                              method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-warning">
                                Перезапустить
                            </button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@camera.Id"
                           class="btn btn-sm btn-outline-primary">
                            Изменить
                        </a>
                        <form asp-action="Delete" asp-route-id="@camera.Id"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Удалить камеру?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>